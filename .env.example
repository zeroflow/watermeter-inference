# Optional: HuggingFace API token (avoids download rate limits during training)
# Get yours at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# Optional: Render group ID for Intel GPU passthrough (default: 44)
# Find yours with: stat -c "%g" /dev/dri/renderD128
# RENDER_GROUP=44
