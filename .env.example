# =============================================================================
# Water Meter Dashboard - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# The .env file will be automatically loaded by docker-compose

# =============================================================================
# Hugging Face Token (for model training)
# =============================================================================
# Required if you want to train new models using timm architectures
# Some pretrained model weights are downloaded from Hugging Face Hub
# Get your token from: https://huggingface.co/settings/tokens
# Leave empty if you only use pre-trained models and don't train new ones
HF_TOKEN=

# =============================================================================
# MQTT Credentials (optional)
# =============================================================================
# If your MQTT broker requires authentication, uncomment and set these
# Otherwise, the application will connect anonymously (if broker allows)
# These can also be configured in config.yaml

# MQTT_USERNAME=your_mqtt_username
# MQTT_PASSWORD=your_mqtt_password

# =============================================================================
# Logging Configuration (optional)
# =============================================================================
# Override the logging level from config.yaml
# Options: DEBUG, INFO, WARNING, ERROR
# Default: INFO

# LOG_LEVEL=INFO

# =============================================================================
# Intel GPU Configuration (optional)
# =============================================================================
# If you want to use Intel GPU for inference acceleration:
# 1. Uncomment the devices and group_add sections in docker-compose.yml
# 2. Find your render group ID: stat -c "%g" /dev/dri/renderD128
# 3. Update the group_add value in docker-compose.yml with the ID below

# Example: RENDER_GROUP=44
# Note: This is for documentation only - update docker-compose.yml directly

# =============================================================================
# Notes
# =============================================================================
# - Main configuration is in config.yaml (auto-created in ./config/ on first run)
# - You can edit config.yaml directly or through the web UI at http://localhost:8001/config
# - This .env file is primarily for sensitive credentials and deployment settings
# - Never commit .env to version control (already in .gitignore)
