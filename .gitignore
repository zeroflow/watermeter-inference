# Python bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Testing and linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Playwright MCP
.playwright-mcp/

# Python packaging
*.egg-info/
dist/
build/

# Node modules (just in case)
node_modules/

# Training data and models (in any subfolder)
**/dataset/
**/ov_model/
**/ground_truth/
**/input/
dataset_temp/

# Debug container volumes
models_debug/
data_debug/
config_debug/

# Generated selected models (created by debug.sh)
/digits/selected/
/arrows/selected/

# Files from inside the running container
data/*
config/*

# Model files (large binaries)
*.bin
*.onnx
*.xml

# Pretrained bootstrap models (override *.bin / *.xml ignore above)
!pretrained/
!pretrained/**

# Screenshots and images in root (not in templates/static)
/*.png
/*.jpg
/*.jpeg

# Claude Code (local settings are personal, agents are shared)
.claude/settings.local.json

# Ephemeral agent communication files
docs/agent_output/

# Secrets
.env
token.txt
.worktrees/

# Publish hygiene
ground_truth_orig_backup_*/
tmp/
/tmp
*.pem
*.key
.env.*
!.env.example
auth.json
*.secrets
