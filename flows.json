ency checks\n// Each position's .5 state should match whether the next position is >= 5\nconst allPositions = [...digits, ...arrows];\nconst allValues = [\n    ...digits.map(d => parseInt(d.class)),\n    ...arrows.map(a => parseFloat(a.class))\n];\n\nfor (let i = 0; i < allValues.length - 1; i++) {\n    const current = allValues[i];\n    const next = allValues[i + 1];\n\n    const currentFraction = current % 1;\n    const currentHasHalf = currentFraction >= 0.4; // arrows can be X.5\n    const nextIntPart = Math.floor(next);\n    const nextIsUpperHalf = nextIntPart >= 5;\n\n    if (currentHasHalf !== nextIsUpperHalf) {\n        const pos = i < digits.length ? digits[i].id : arrows[i - digits.length].id;\n        const nextPos = i + 1 < digits.length ? digits[i + 1].id : arrows[i + 1 - digits.length].id;\n        warnings.push(`${pos}=${current} (half=${currentHasHalf}) vs ${nextPos}=${next} (upper=${nextIsUpperHalf})`);\n    }\n}\n\nmsg.payload = {\n    total: Math.round(total * 10000) / 10000,\n    warnings: warnings,\n    valid: warnings.length === 0\n};\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1000,"y":880,"wires":[["73b3b474c6c95043","a94178662be3522b"]]},{"id":"73b3b474c6c95043","type":"debug","z":"e5a45e3e7a235777","name":"debug 12","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":1200,"y":840,"wires":[]},{"id":"a94178662be3522b","type":"change","z":"e5a45e3e7a235777","name":"","rules":[{"t":"set","p":"payload","pt":"msg","to":"payload.total","tot":"msg"}],"action":"","property":"","from":"","to":"","reg":false,"x":1180,"y":880,"wires":[["e16d8387abaa1561","96af7cbaa6786865"]]},{"id":"f49dad8c65c96822","type":"ha-sensor","z":"e5a45e3e7a235777","name":"Warning Messages","entityConfig":"7879357780b9775d","version":0,"state":"payload","stateType":"msg","attributes":[],"inputOverride":"allow","outputProperties":[],"x":1590,"y":880,"wires":[