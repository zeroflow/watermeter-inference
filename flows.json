; i < arrows.length; i++) {\n    const current = parseFloat(arrows[i].class);\n    \n    if (i < arrows.length - 1) {\n        const next = parseFloat(arrows[i + 1].class);\n        // Next arrow's integer part indicates where current arrow's fraction should be\n        const expectedFraction = Math.floor(next) / 10;\n        const actualFraction = (current % 1 >= 0.5) ? 0.5 : 0.0;\n        \n        // Current arrow at X.0 = pointing at digit X exactly\n        // Current arrow at X.5 = pointing between X and X+1\n        // This should match next arrow: if next is 0-4, current should be X.0; if next is 5-9, current should be X.5\n        const expectedHalf = Math.floor(next) >= 5 ? 0.5 : 0.0;\n        \n        if (actualFraction !== expectedHalf) {\n            node.warn(`Inconsistency at position ${i}: arrow[${i}]=${current} (fraction ${actualFraction}), arrow[${i+1}]=${next} implies fraction ${expectedHalf}`);\n        }\n    }\n    \n    total += Math.floor(current) / divisor;\n    divisor *= 10;\n}\n\nmsg.payload = total;\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":710,"y":980,"wires":[["e16d8387abaa1561"]]},{"id":"6568b2df43ac59c7","type":"mqtt in","z":"e5a45e3e7a235777","name":"","topic":"watermeter/status","qos":"2","datatype":"auto-detect","broker":"ca6c05505eb680b8","nl":false,"rap":true,"rh":0,"inputs":0,"x":150,"y":60,"wires":[["265394c09b684cab"]]},{"id":"265394c09b684cab","type":"switch","z":"e5a45e3e7a235777","name":"","property":"payload","propertyType":"msg","rules":[{"t":"eq","v":"Flow finished","vt":"str"}],"checkall":"true","repair":false,"outputs":1,"x":330,"y":60,"wires":[["4ca41af10ef3324b"]]},{"id":"3c04208e3c091348","type":"ha-sensor","z":"e5a45e3e7a235777","name":"Usage","entityConfig":"7879357780b9775d","version":0,"state":"payload","stateType":"msg","attributes":[],"inputOverride":"allow","outputProperties":[],"x":1090,"y":1020,"wires":[[]]},{"id":"e16d8387abaa1561","type":"function","z"